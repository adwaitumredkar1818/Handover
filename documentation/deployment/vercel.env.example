# ==============================================================================
# The Handover (Intelligent Project Knowledge Reconstruction & Handover Platform)
# Production Environment Variable Template: Vercel (Next.js Frontend)
#
# SECURITY RULES:
# - Configure these variables in the Vercel Project Dashboard (Settings > Environment Variables).
# - ONLY variables prefixed with NEXT_PUBLIC_* are bundled into client JavaScript.
# - NEVER expose backend secrets, API tokens, encryption keys, or service-role keys here.
# ==============================================================================

# --- Backend API Connection ---
# Public URL of the FastAPI backend deployed on Render (HTTPS mandatory in production)
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1

# --- Supabase Client (Auth & Public Handshake) ---
# Project URL from Supabase Dashboard (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://rjntmboskzyrsqcetzil.supabase.co

# Public Anon API Key from Supabase Dashboard (Safe for browser exposure; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# --- Development / Observability Flags ---
# Must remain false in production to prevent localhost probes
NEXT_PUBLIC_ENABLE_AGENTATION=false

# ==============================================================================
# The Handover (Intelligent Project Knowledge Reconstruction & Handover Platform)
# Production Environment Variable Template: Local Windows AI Server
#
# Topology: Windows 11 Laptop with NVIDIA RTX 4050 GPU (6GB VRAM)
# Services: Ollama (LLM/OCR/Embeddings), ChromaDB (Docker), Redis (Docker),
#           Local Background Worker process, and Cloudflare Tunnel (`cloudflared`).
# ==============================================================================

# --- Local Service Endpoints (Loopback Only) ---
LOCAL_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_CHROMA_URL=http://127.0.0.1:8001
LOCAL_REDIS_URL=redis://127.0.0.1:6379/0

# --- Local Inference Gateway ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8002
# Shared bearer token expected in Authorization header from Render FastAPI
INFERENCE_GATEWAY_API_KEY=generate-secure-gateway-bearer-token

# --- Ollama Runtime Concurrency & Memory Constraints (RTX 4050 6GB Optimization) ---
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_OCR_MODEL=glm-ocr:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Local Background Worker (Processes Ingestion & OCR locally) ---
# Connects directly to remote Supabase PostgreSQL over TLS (Session Pooler port 5432)
DATABASE_URL=postgresql+psycopg://postgres.rjntmboskzyrsqcetzil:YOUR_URL_ENCODED_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
POSTGRES_SSL_MODE=require
POSTGRES_CONNECT_TIMEOUT_SECONDS=15

# Encryption & Storage Keys (Must match Render Backend for payload decryption)
FILE_ENCRYPTION_KEY=generate-secure-32-byte-file-encryption-key
TOKEN_ENCRYPTION_KEY=generate-secure-32-byte-fernet-key
STORAGE_PROVIDER=supabase_storage
SUPABASE_URL=https://rjntmboskzyrsqcetzil.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=project-evidence

# Worker Leases
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=300

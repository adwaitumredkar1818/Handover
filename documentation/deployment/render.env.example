# ==============================================================================
# The Handover (Intelligent Project Knowledge Reconstruction & Handover Platform)
# Production Environment Variable Template: Render (FastAPI Web Service)
#
# SECURITY & ARCHITECTURE RULES:
# - Configure these variables in the Render Dashboard (Environment tab).
# - Keep all secrets, database credentials, and symmetric encryption keys strictly here.
# - NEVER share these keys with client browsers or frontends.
# ==============================================================================

# --- Application Runtime & Environment ---
APP_ENV=production
LOG_LEVEL=INFO
APP_NAME="Intelligent Project Knowledge Reconstruction & Handover Platform"

# --- Host & Port (Render dynamically assigns PORT) ---
BACKEND_HOST=0.0.0.0
# BACKEND_PORT is supplied automatically by Render via $PORT

# --- CORS Security ---
# Comma-separated list of allowed frontend origins (e.g. Vercel production & preview domains)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://your-project.vercel.app

# --- Canonical Database: Supabase PostgreSQL (Sydney: ap-southeast-2) ---
# MUST use Session Pooler on port 5432 (required for Alembic, prepared statements, and transaction locks)
# Percent-encode special characters in password (e.g. @ -> %40, # -> %23, : -> %3A)
DATABASE_URL=postgresql+psycopg://postgres.rjntmboskzyrsqcetzil:YOUR_URL_ENCODED_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
POSTGRES_SSL_MODE=require
POSTGRES_CONNECT_TIMEOUT_SECONDS=15

# --- Platform Identity & Token Encryption Keys ---
# Generate minimum 32-byte cryptographic random secrets
JWT_SECRET_KEY=generate-secure-random-32-byte-hex-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=ipkrh-platform
JWT_AUDIENCE=ipkrh-api

# Backend symmetric key for encrypting stored external source OAuth tokens in PostgreSQL
TOKEN_ENCRYPTION_KEY=generate-secure-32-byte-fernet-key

# Backend symmetric key for encrypting uploaded files at rest in object storage
FILE_ENCRYPTION_KEY=generate-secure-32-byte-file-encryption-key

# --- Cookie Security (Mandatory for HTTPS Cross-Site Production) ---
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=

# --- Rate Limiting ---
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Supabase Auth Integration (Google OAuth Token Exchange) ---
SUPABASE_AUTH_ENABLED=true
SUPABASE_AUTH_AUDIENCE=authenticated
# Supabase project URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_AUTH_URL=https://rjntmboskzyrsqcetzil.supabase.co
# JWKS endpoint for asymmetric RS256/ES256 verification (Recommended; no shared secret needed)
SUPABASE_AUTH_JWKS_URL=https://rjntmboskzyrsqcetzil.supabase.co/auth/v1/.well-known/jwks.json
# Optional symmetric secret fallback if project uses HS256 tokens:
SUPABASE_JWT_SECRET=

# --- Private Document Storage (Supabase Storage Backend) ---
STORAGE_PROVIDER=supabase_storage
SUPABASE_URL=https://rjntmboskzyrsqcetzil.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=project-evidence
SUPABASE_STORAGE_TIMEOUT_SECONDS=30.0
SUPABASE_STORAGE_MAX_RETRIES=2
SUPABASE_STORAGE_RETRY_BACKOFF_SECONDS=0.5
SUPABASE_STORAGE_VERIFY_CIPHERTEXT_SIZE=true

# --- Upload Constraints ---
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_PAGES=200

# --- Secure Connectivity: Local AI Server via Cloudflare Tunnel ---
# Gateway Client settings for Render backend
INFERENCE_GATEWAY_ENABLED=true
INFERENCE_GATEWAY_BASE_URL=https://gateway-ai.yourdomain.com
INFERENCE_GATEWAY_TOKEN=your-shared-inference-gateway-bearer-token
INFERENCE_GATEWAY_TIMEOUT_SECONDS=120.0
# Cloudflare Access Service Token authentication headers (Render -> Cloudflare Access)
# CF_ACCESS_ALLOWED_HOST must exactly match the hostname of INFERENCE_GATEWAY_BASE_URL
CF_ACCESS_CLIENT_ID=your-cloudflare-access-service-token-client-id
CF_ACCESS_CLIENT_SECRET=your-cloudflare-access-service-token-client-secret
CF_ACCESS_ALLOWED_HOST=gateway-ai.yourdomain.com

# Legacy direct variables (for local/direct reference)
OLLAMA_BASE_URL=https://gateway-ai.yourdomain.com
CHROMA_HOST=gateway-ai.yourdomain.com
CHROMA_PORT=443
CHROMA_COLLECTION_PREFIX=ipkrh
CHROMA_AUTH_TOKEN=your-shared-inference-gateway-bearer-token

# --- Cloud Caching (Optional in initial phase, fallback to in-memory) ---
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==============================================================================
# The Handover — Frontend Environment Variables Template
# ==============================================================================
# Security Notice (AGENTS.md § 6):
# All NEXT_PUBLIC_* variables are baked into browser client bundles and visible
# to end users. NEVER put backend secrets (DATABASE_URL, JWT_SECRET_KEY,
# RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY, or encryption keys) in this file.
# Backend secrets are managed strictly in backend runtime environments (Render/local).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Routing
# ------------------------------------------------------------------------------
# In local development: http://localhost:8000/api/v1 (or proxy rewrite /api/v1)
# In production & preview: https://the-handover-api.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. Supabase Client Configuration
# ------------------------------------------------------------------------------
# Public anonymous credentials for browser-side client initialization
NEXT_PUBLIC_SUPABASE_URL=https://rjntmboskzyrsqcetzil.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 3. Development & Observability Tooling
# ------------------------------------------------------------------------------
# Enable Agentation development toolbar (strictly false in production/preview)
NEXT_PUBLIC_ENABLE_AGENTATION=false

# ------------------------------------------------------------------------------
# 4. Frontend Application Base URL
# ------------------------------------------------------------------------------
# Base URL for frontend application links (invitations, email verifications, password resets)
# In local development: http://localhost:3000
# In production: https://the-handover.vercel.app
FRONTEND_BASE_URL=http://localhost:3000

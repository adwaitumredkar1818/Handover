# ==============================================================================
# LOCAL INFERENCE GATEWAY CONFIGURATION (Phase M3.1)
# ==============================================================================
# Security requirement: Gateway must bind strictly to 127.0.0.1 (never 0.0.0.0 or LAN)
INFERENCE_GATEWAY_HOST=127.0.0.1
INFERENCE_GATEWAY_PORT=8002

# Secret API key for authenticating incoming requests from Cloudflare Tunnel / Cloud Backend
# Minimum length: 32 characters
INFERENCE_GATEWAY_API_KEY=dev-local-gateway-secret-token-min-32-chars

# Upstream local services
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHROMA_BASE_URL=http://127.0.0.1:8001
REDIS_BASE_URL=redis://127.0.0.1:6379/0

# Concurrency and timeout controls (RTX 4050 6GB VRAM protection)
GATEWAY_MAX_CONCURRENCY=1
GATEWAY_CONCURRENCY_TIMEOUT=30.0
GATEWAY_REQUEST_TIMEOUT=120.0
GATEWAY_EMBED_TIMEOUT=30.0
GATEWAY_MAX_BODY_BYTES=1048576
